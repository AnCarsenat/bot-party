; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bot Party"
run/main_scene="res://ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://player/icon.png"

[audio]

buses/default_bus_layout="res://audio/default_bus_layout.tres"

[autoload]

Mods="*res://mods/mods.gd"
DebugView="*res://core/debug_view.gd"
AmbientSfx="*res://audio/ambient_sfx.tscn"
Music="*res://audio/music_player.gd"
Transition="*res://core/transition.gd"
GameState="*res://core/game_state.gd"
Hud="*res://ui/hud.gd"
Party="*res://party/party.gd"
Net="*res://net/net.gd"
Console="*res://ui/console.gd"
CommandLine="*res://core/command_line.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

